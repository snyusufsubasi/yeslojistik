# Bu dosyayı .env olarak kopyalayıp doldurun. .env dosyasını ASLA git'e eklemeyin.

# Veritabanı şifresi (uzun, rastgele)
POSTGRES_PASSWORD=degistir-beni

# JWT imza anahtarı: en az 32 karakter. Üretmek için: openssl rand -base64 48
JWT_KEY=

# İlk yönetici hesabı (yalnızca veritabanında hiç kullanıcı yokken oluşturulur)
ADMIN_EMAIL=admin@yeslojistik.com
ADMIN_PASSWORD=

# Demo için örnek veri yüklensin mi? Canlıda false kalmalı.
SAMPLE_DATA=false

# Yerelde web portu
WEB_PORT=8080
# HTTPS arkasındaysanız true
SECURE_COOKIES=false

# Canlı sunucu (docker-compose.prod.yml)
DOMAIN=panel.yeslojistik.com
BACKUP_KEEP_DAYS=30
